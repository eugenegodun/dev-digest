{
  "name": "@devdigest/mcp-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local MCP server for DevDigest — thin stdio client over the @devdigest/api review engine (:3001). Exposes reviewer tools to MCP hosts.",
  "bin": {
    "devdigest-mcp": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:it": "vitest run .it.test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "eventsource-parser": "^3.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
