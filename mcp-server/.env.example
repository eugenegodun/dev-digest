# DevDigest API base URL (the @devdigest/api server must be running here).
DEVDIGEST_API_BASE_URL=http://localhost:3001

# Optional. Forward-compat only — the local API resolves the workspace server-side
# and currently ignores this. Validated as a UUID if set.
# DEVDIGEST_WORKSPACE_ID=

# Max time run_agent_on_pr blocks waiting for a review before returning a run_id
# and a hint to fetch findings later. Milliseconds.
DEVDIGEST_RUN_TIMEOUT_MS=180000

# Fallback poll cadence (ms) used when the SSE run-event stream is unavailable.
DEVDIGEST_POLL_INTERVAL_MS=2000
